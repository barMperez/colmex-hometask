# Copy to .env to override defaults. All values below are the defaults.

# Database. SQLite for zero-setup local runs; docker compose uses Postgres:
#   postgresql+asyncpg://rates:rates@localhost:5433/rates
DATABASE_URL=sqlite+aiosqlite:///./rates.db

# Bank of Israel source
BOI_URL=https://boi.org.il/PublicApi/GetExchangeRates
BOI_TIMEOUT_SECONDS=10
BOI_MAX_ATTEMPTS=3

# Refresh process polling (Asia/Jerusalem business-day window)
REFRESH_WINDOW_INTERVAL_SECONDS=300
REFRESH_OFF_WINDOW_INTERVAL_SECONDS=3600
REFRESH_WINDOW_START=12:00
REFRESH_WINDOW_END=18:00

# API process
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

LOG_LEVEL=INFO
